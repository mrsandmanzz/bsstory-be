# Local development uses a SQLite file. In production use Turso (libsql://...).
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Required in production: the API refuses to start without these three.
JWT_SECRET=change-me-in-production
ADMIN_EMAILS=admin@mainstory.test

CURRENCY=IDR
# Comma-separated list of web origins allowed by CORS (set to the web app URL in production).
ALLOWED_ORIGINS=*
# Seeds 6 demo books and 3 demo accounts when the database is empty. Opt in with true in production.
AUTO_SEED=true

# Launch offer (a limited-time discount on the first subscription payment).
# Development has a built-in demo offer; in production there is NO offer unless both are set.
# PROMO_PERCENT=30
# PROMO_ENDS_AT=2026-11-30T16:59:59Z
# PROMO_LABEL=Launch offer
